{
    "name": "juanparati/mybackup",
    "description": "A MySQL/MariaDB backup tool",
    "keywords": [
        "mysql",
        "mariadb",
        "backup",
        "console",
        "tool",
        "encrypt"
    ],
    "homepage": "https://github.com/mybackup",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Juan Lago",
            "email": "juanparati@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3.0",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-zlib": "*",
        "illuminate/database": "^13.0",
        "laravel-zero/framework": "^13.0",
        "laravel/slack-notification-channel": "^3.2",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.0",
        "league/flysystem-google-cloud-storage": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "spatie/laravel-google-cloud-storage": "^2.4",
        "symfony/process": "^7.1",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.15.2",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "vendor/laravel/framework/src/Illuminate/Foundation"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "mybackup"
    ],
    "scripts": {
        "lint": [
            "@php vendor/bin/pint",
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    }
}
